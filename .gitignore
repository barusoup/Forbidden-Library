# Build output
/target/
/dist/

# Downloaded tools. The folders are produced by the package and fetch scripts
# (scripts/fetch-semantic.ps1, scripts/fetch-assets.sh) and are never edited by
# hand; the binaries are large. vendor/ holds the Windows and Linux tools and
# the bundled search model, assets/ holds the tool binaries package.ps1 copies
# beside the app.
/assets/ffmpeg/ffmpeg.exe
/assets/ffmpeg/ffprobe.exe
/assets/jxl/cjxl.exe
/assets/jxl/djxl.exe
/vendor/

# Runtime state and logs
/logs/
*.log
*.pdb

# Staging and archives produced locally
*.zip
*.tmp
*.stage

# Windows and editor litter
Thumbs.db
desktop.ini
.DS_Store

# Personal tooling notes
/AGENTS.md
/CLAUDE.md
/.claude/
